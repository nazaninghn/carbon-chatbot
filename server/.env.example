# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development   # change to "production" on server

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/carboniq
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/carboniq?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/carboniq

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_EXPIRES_IN=7d

# ── Groq (free LLM) ───────────────────────────────────────────────────────────
# Get key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
CHAT_MODEL=llama-3.3-70b-versatile
CHAT_TEMPERATURE=0.3
CHAT_MAX_TOKENS=2000

# ── OpenAI embeddings (optional) ─────────────────────────────────────────────
# Set to MOCK_MODE to skip vector embeddings (uses LLM-only validation)
OPENAI_API_KEY=MOCK_MODE
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Client origin (CORS) ─────────────────────────────────────────────────────
# For production add your Vercel/custom domain here.
# localhost and *.vercel.app are always allowed automatically.
CLIENT_URL=http://localhost:5173

# ── Admin panel (basic-auth for /admin/* HTML routes) ────────────────────────
# Access the panel at /admin — these protect the HTML dashboard, not the API.
ADMIN_PANEL_KEY=change-this-secret-key
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASS=change-this-password

# ── Admin promotion (dev only, disabled in production) ───────────────────────
# POST /api/auth/promote-admin  { email, secret }
ADMIN_PROMOTE_SECRET=change-this-promote-secret

# ── MCP ───────────────────────────────────────────────────────────────────────
MCP_SERVER_PORT=3002
MCP_SERVER_NAME=carboniq-mcp
