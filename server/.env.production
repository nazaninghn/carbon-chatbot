# Copy these values into Railway environment variables
# DO NOT commit this file with real secrets

PORT=3001
NODE_ENV=production

# MongoDB Atlas — get from: https://cloud.mongodb.com
# Format: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/carboniq?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://REPLACE_WITH_YOUR_ATLAS_URI

# JWT — generate a random 64-char string
# Run in terminal: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d

# Groq API key (same as dev)
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_KEY
CHAT_MODEL=llama-3.3-70b-versatile
CHAT_TEMPERATURE=0.3
CHAT_MAX_TOKENS=2000

# OpenAI (keep MOCK_MODE unless you have a paid key)
OPENAI_API_KEY=MOCK_MODE

# Client URL — your Vercel deployment URL
CLIENT_URL=https://REPLACE_WITH_YOUR_VERCEL_URL.vercel.app

# MCP
MCP_SERVER_PORT=3002
MCP_SERVER_NAME=carboniq-mcp
